---
import Layout from "../layouts/Layout.astro";

// TODO: replace with the real App Store listing id once published (bundle com.verdancy.app)
const appStoreUrl = "https://apps.apple.com/app/verdancy/id0000000000";
// Public, verified planting profile; the real count lives here (the app links here too).
const treeNationUrl = "https://tree-nation.com/profile/verdancy";
---

<Layout>
  <!-- ===================== HEADER ===================== -->
  <header class="site-header">
    <div class="container">
      <a class="brand" href="/" aria-label="Verdancy home">
        <span class="mark"><img src="/verdancy-mark.png" alt="" width="34" height="34" /></span>
        Verdancy
      </a>

      <nav class="nav-links" aria-label="Primary">
        <a href="#features">Features</a>
        <a href="#trees">Real trees</a>
        <a href="#pricing">Pricing</a>
        <a href="/trees.html">Tree counter</a>
      </nav>

      <div class="nav-right">
        <button class="theme-toggle" data-theme-toggle type="button" aria-label="Toggle dark mode">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <a class="btn btn-primary btn-sm" href={appStoreUrl}>Download</a>
      </div>
    </div>
  </header>

  <main>
    <!-- ===================== HERO ===================== -->
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <a class="pill-badge" href={treeNationUrl} target="_blank" rel="noopener">
            <span class="dot"></span>
            Real trees, planted with&nbsp;<strong>Tree Nation</strong>
          </a>
          <h1>You grow plants.<br /><span class="grad-text">We grow forests.</span></h1>
          <p class="lede">
            Point your camera at any plant to get its name, whether it's pet-safe, and how to
            keep it thriving in seconds. Keep your plants alive, and we plant{" "}
            <strong>10 real trees</strong> with our partner Tree Nation.
          </p>
          <div class="hero-actions">
            <a class="appstore" href={appStoreUrl} aria-label="Download on the App Store">
              <svg class="asb" viewBox="0 0 120 40" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Download on the App Store">
                <rect x="0.5" y="0.5" width="119" height="39" rx="8.5" fill="#000" stroke="#A6A6A6"/>
                <g transform="translate(3.82 7.83) scale(0.96)"><path fill="#fff" d="M16.4 12.9c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.9-.8-3-.8-1.6 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.2.8 1.1 1.7 2.4 3 2.3 1.2-.05 1.6-.8 3-.8s1.8.8 3 .75c1.3 0 2.1-1.1 2.9-2.3.6-.9.9-1.7 1.2-2.6-2.5-1-2.6-3.4-2.6-3.85ZM14.2 6.3c.7-.8 1.1-1.9 1-3-.95.05-2.1.6-2.8 1.4-.6.7-1.1 1.9-1 2.9 1.05.1 2.1-.5 2.8-1.3Z"/></g>
                <text x="29" y="15.5" fill="#fff" font-family="-apple-system, 'SF Pro Text', system-ui, Helvetica, Arial, sans-serif" font-size="6.6" font-weight="400" letter-spacing="0.3">Download on the</text>
                <text x="28.5" y="31" fill="#fff" font-family="-apple-system, 'SF Pro Display', system-ui, Helvetica, Arial, sans-serif" font-size="16.5" font-weight="500" letter-spacing="-0.5">App Store</text>
              </svg>
            </a>
            <a class="btn btn-secondary" href="#trees">See the tree counter</a>
          </div>
          <div class="hero-trust">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z"/><path d="M9 12.5l2 2 4-4.5"/></svg>
            <span>Real trees, publicly counted with our partner <strong>Tree Nation</strong></span>
          </div>
        </div>

        <!-- Phone mock -->
        <div class="hero-visual">
          <div class="glow"></div>
          <div class="phone">
            <div class="phone-screen">
              <div class="scan-photo">
                <svg class="plant-art" viewBox="0 0 200 200" fill="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0" stop-color="#6FB477"/><stop offset="1" stop-color="#2C5C33"/>
                    </linearGradient>
                  </defs>
                  <path d="M100 175c0-40-4-70-4-70" stroke="#3E7E46" stroke-width="5" stroke-linecap="round"/>
                  <path d="M96 118c-20-6-34-26-32-52 24 2 40 22 40 48" fill="url(#lg)" opacity="0.95"/>
                  <path d="M104 112c22-4 36-24 36-50-24 0-42 20-42 46" fill="url(#lg)"/>
                  <path d="M98 128c-24 2-42 18-46 44 26 4 48-12 52-38" fill="url(#lg)" opacity="0.85"/>
                  <path d="M102 132c24 0 44 14 50 40-26 6-50-8-56-34" fill="url(#lg)" opacity="0.9"/>
                  <path d="M100 96c-14 0-24-14-24-34 18 0 28 14 28 34" fill="#8FD69A" opacity="0.9"/>
                </svg>
                <div class="scan-frame"><span></span><span></span><span></span><span></span></div>
                <div class="scan-sweep"></div>
              </div>
              <div class="scan-result">
                <div class="sr-head">
                  <div>
                    <div class="sr-name">Calathea orbifolia</div>
                    <div class="sr-sub">Marantaceae · Prayer-plant family</div>
                  </div>
                  <div class="sr-match">96%</div>
                </div>
                <div class="sr-chips">
                  <span class="chip safe">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    Pet-safe
                  </span>
                  <span class="chip">Easy care</span>
                </div>
                <div class="sr-care">
                  <div class="sr-care-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg>
                    <span><b>Water</b> in 4 days</span>
                  </div>
                  <div class="sr-care-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    <span><b>Light</b> bright, indirect</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="float-badge float-buddy">
            <span class="fb-icon">🌱</span>
            <div><b>Buddy leveled up</b><small>Orbi is blooming</small></div>
          </div>
          <div class="float-badge float-streak">
            <span class="fb-icon">🔥</span>
            <div><b>12-day streak</b><small>Nice work</small></div>
