<script>
  // mobile menu
  const menuBtn = document.getElementById('menuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  menuBtn.addEventListener('click', () => {
    const open = mobileMenu.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', open);
  });

  // count-up for impact counter
  const counterEl = document.getElementById('counterKg');
  const target = 128492; // sample figure — replace with real data source
  let started = false;
  function formatNum(n){ return n.toLocaleString('en-US'); }
  function countUp(){
    if(started) return;
    started = true;
    const duration = 1600;
    const start = performance.now();
    function tick(now){
      const p = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - p, 3);
      counterEl.textContent = formatNum(Math.floor(eased * target));
      if(p < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if(e.isIntersecting) countUp(); });
  }, { threshold: 0.4 });
  obs.observe(counterEl);
</script>

