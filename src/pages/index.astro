---
import Layout from "../layouts/Layout.astro";

const appStoreUrl = "https://apps.apple.com/us/app/verdancy-plant-id-care/id6791885203";
// Public, verified planting profile; the real count lives here (the app links here too).
const treeNationUrl = "https://tree-nation.com/profile/verdancy";
---

<Layout>
  <!-- ===================== HEADER ===================== -->
  <header class="site-header">
    <div class="container">
      <a class="brand" href="/" aria-label="Verdancy home">
        <span class="mark"><img src="/verdancy-mark.png" alt="" width="34" height="34" /></span>
        Verdancy
      </a>

      <nav class="nav-links" aria-label="Primary">
        <a href="#tour">Screens</a>
        <a href="#trees">Real trees</a>
        <a href="/trees.html">Tree counter</a>
      </nav>

      <div class="nav-right">
        <button class="theme-toggle" data-theme-toggle type="button" aria-label="Toggle dark mode">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <a class="btn btn-primary btn-sm" href={appStoreUrl}>Download</a>
      </div>
    </div>
  </header>

  <main>
    <!-- ===================== HERO ===================== -->
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <a class="pill-badge" href={treeNationUrl} target="_blank" rel="noopener">
            <span class="dot"></span>
            Real trees, planted with&nbsp;<strong>Tree Nation</strong>
          </a>
          <h1>You grow plants.<br /><span class="grad-text">We grow forests.</span></h1>
          <p class="lede">
            Point your camera at any plant to get its name, whether it's pet-safe, and how to
            keep it thriving in seconds. Keep your plants alive, and we plant{" "}
            <strong>10 real trees</strong> with our partner Tree Nation.
          </p>
          <div class="hero-actions">
            <a class="appstore" href={appStoreUrl} aria-label="Download on the App Store">
              <img class="asb" src="/appstore-badge.svg" width="120" height="40" alt="Download on the App Store" />
            </a>
            <a class="btn btn-secondary" href="#trees">See the tree counter</a>
          </div>
          <div class="hero-trust">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z"/><path d="M9 12.5l2 2 4-4.5"/></svg>
            <span>Real trees, publicly counted with our partner <strong>Tree Nation</strong></span>
          </div>
        </div>

        <!-- Phone mock -->
        <div class="hero-visual">
          <div class="glow"></div>
          <div class="phone">
            <div class="phone-screen">
              <div class="scan-photo">
                <svg class="plant-art" viewBox="0 0 200 200" fill="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0" stop-color="#6FB477"/><stop offset="1" stop-color="#2C5C33"/>
                    </linearGradient>
                  </defs>
                  <path d="M100 175c0-40-4-70-4-70" stroke="#3E7E46" stroke-width="5" stroke-linecap="round"/>
                  <path d="M96 118c-20-6-34-26-32-52 24 2 40 22 40 48" fill="url(#lg)" opacity="0.95"/>
                  <path d="M104 112c22-4 36-24 36-50-24 0-42 20-42 46" fill="url(#lg)"/>
                  <path d="M98 128c-24 2-42 18-46 44 26 4 48-12 52-38" fill="url(#lg)" opacity="0.85"/>
                  <path d="M102 132c24 0 44 14 50 40-26 6-50-8-56-34" fill="url(#lg)" opacity="0.9"/>
                  <path d="M100 96c-14 0-24-14-24-34 18 0 28 14 28 34" fill="#8FD69A" opacity="0.9"/>
                </svg>
                <div class="scan-frame"><span></span><span></span><span></span><span></span></div>
                <div class="scan-sweep"></div>
              </div>
              <div class="scan-result">
                <div class="sr-head">
                  <div>
                    <div class="sr-name">Calathea orbifolia</div>
                    <div class="sr-sub">Marantaceae · Prayer-plant family</div>
                  </div>
                  <div class="sr-match">96%</div>
                </div>
                <div class="sr-chips">
                  <span class="chip safe">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    Pet-safe
                  </span>
                  <span class="chip">Easy care</span>
                </div>
                <div class="sr-care">
                  <div class="sr-care-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg>
                    <span><b>Water</b> in 4 days</span>
                  </div>
                  <div class="sr-care-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    <span><b>Light</b> bright, indirect</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="float-badge float-buddy">
            <span class="fb-icon">🌱</span>
            <div><b>Buddy leveled up</b><small>Orbi is blooming</small></div>
          </div>
          <div class="float-badge float-streak">
            <span class="fb-icon">🔥</span>
            <div><b>12-day streak</b><small>Nice work</small></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== APP TOUR / SCREENS ===================== -->
    <section class="section tour" id="tour">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">A look inside</span>
          <h2>See it in action.</h2>
          <p>From a first scan to a thriving windowsill, here's the whole journey.</p>
        </div>
        <ul class="tour-grid" role="list">
          <li class="tour-shot"><img src="/screens/01-identify.jpg" width="462" height="1000" loading="lazy" alt="Smart Scan identifying a Monstera Deliciosa with a high-match badge, pet-toxicity warning and taxonomy." /></li>
          <li class="tour-shot"><img src="/screens/02-careplan.jpg" width="462" height="1000" loading="lazy" alt="A plant's care plan showing watering, light and nutrient schedules with reminders." /></li>
          <li class="tour-shot"><img src="/screens/07-diagnose.jpg" width="462" height="1000" loading="lazy" alt="Smart Scan diagnosing early root rot with ordered fix steps and a confidence score." /></li>
          <li class="tour-shot"><img src="/screens/06-planreveal.jpg" width="462" height="1000" loading="lazy" alt="A personalized care plan built for your home, tuned to your plants and light." /></li>
          <li class="tour-shot"><img src="/screens/04-today.jpg" width="462" height="1000" loading="lazy" alt="The Today tab with a care streak, real-tree count and a due-now checklist." /></li>
          <li class="tour-shot"><img src="/screens/08-oasis.jpg" width="462" height="1000" loading="lazy" alt="My Oasis, a grid of saved plants each with its own collectible Plant Buddy." /></li>
          <li class="tour-shot"><img src="/screens/05-bloom.jpg" width="462" height="1000" loading="lazy" alt="A Plant Buddy blooming with Premium, reserving ten real trees for your forest." /></li>
          <li class="tour-shot"><img src="/screens/03-trees.jpg" width="462" height="1000" loading="lazy" alt="The Trees tab showing real trees planted, CO2 absorbed and their locations." /></li>
        </ul>
      </div>
    </section>

    <!-- ===================== PILLARS ===================== -->
    <section class="section pillars">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Why Verdancy</span>
          <h2>Plant ID is table stakes. This is what keeps you coming back.</h2>
          <p>Every plant app can name a leaf now. Only Verdancy turns your care into real forests, living companions, and a habit that sticks.</p>
        </div>
        <div class="pillar-grid">
          <article class="card pillar">
            <span class="icon-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22V9"/><path d="M12 13c-3.3 0-6-2.7-6-6 3.3 0 6 2.7 6 6Z"/><path d="M12 11c0-3.3 2.7-6 6-6 0 3.3-2.7 6-6 6Z"/><path d="M8 22h8"/></svg>
            </span>
            <h3>Real trees planted</h3>
            <p>Go Premium and we plant real trees with our partner Tree Nation (<strong>10 on an annual plan</strong>), plus one more at every care milestone. Verified on Tree Nation's public profile.</p>
          </article>
          <article class="card pillar">
            <span class="icon-circle terracotta">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21v-7"/><path d="M12 14c-3 0-5.2-2.2-5.2-5.2C9.8 8.8 12 11 12 14Z"/><path d="M12 12c0-3 2.2-5.2 5.2-5.2C17.2 9.8 15 12 12 12Z"/><circle cx="12" cy="6" r="2.4"/></svg>
            </span>
            <h3>Plant Buddies</h3>
            <p>Every plant you save grows its own collectible chibi “bud” that blooms as you care for it. Look what's growing for you.</p>
          </article>
          <article class="card pillar">
            <span class="icon-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3s5.5 4.8 5.5 9.5a5.5 5.5 0 0 1-11 0c0-1.8.6-3.5 1.6-5"/><path d="M12 21v-4.5"/></svg>
            </span>
            <h3>Care streaks</h3>
            <p>Daily care builds a gentle streak: a calm habit tracker that keeps your plants (and you) thriving, never a guilt trip.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ===================== TREE COUNTER / CREDIBILITY ===================== -->
    <section class="section trees" id="trees">
      <div class="container">
        <div class="trees-panel">
          <div class="trees-copy">
            <span class="eyebrow on-grad">Real trees, publicly counted</span>
            <h2>You grow plants. We grow forests.</h2>
            <p>
              Every annual subscription funds <strong>10 real trees</strong> through our partner{" "}
              <strong>Tree Nation</strong> when your first payment clears, plus one more at every
              milestone. No vague “we help the planet.” A real partner, a real count, verified.
            </p>
            <div class="trees-count">
              <span class="tc-num">10</span>
              <span class="tc-label">real trees per subscriber, plus milestones</span>
            </div>
            <div class="trees-actions">
              <a class="btn btn-onlight" href={treeNationUrl} target="_blank" rel="noopener">See our count on Tree Nation ↗</a>
              <a class="btn btn-ghost-onlight" href={appStoreUrl}>Plant your first seed 🌱</a>
            </div>
          </div>
          <div class="trees-art" aria-hidden="true">
            <svg viewBox="0 0 220 220" fill="none">
              <circle cx="110" cy="110" r="96" stroke="rgba(255,255,255,.35)" stroke-width="1.5" stroke-dasharray="4 8"/>
              <circle cx="110" cy="110" r="70" stroke="rgba(255,255,255,.25)" stroke-width="1.5" stroke-dasharray="4 8"/>
              <path d="M110 180v-42" stroke="#EAF6EC" stroke-width="7" stroke-linecap="round"/>
              <path d="M110 150c-30 0-52-22-52-56 34 0 56 24 56 60" fill="#EAF6EC"/>
              <path d="M112 140c30-2 52-24 52-58-34 0-54 24-54 58" fill="#C7ECCD"/>
              <path d="M110 120c-18-2-32-16-32-40 24 0 34 16 34 40" fill="#A7DDB0"/>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== FINAL CTA ===================== -->
    <section class="section final-cta">
      <div class="container">
        <div class="cta-band">
          <h2>Never kill a plant again.</h2>
          <p>Know every plant you meet, keep them thriving, and grow a real forest while you do it.</p>
          <a class="appstore" href={appStoreUrl} aria-label="Download on the App Store">
            <img class="asb" src="/appstore-badge.svg" width="120" height="40" alt="Download on the App Store" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- ===================== FOOTER ===================== -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/">
            <span class="mark"><img src="/verdancy-mark.png" alt="" width="34" height="34" /></span>
            Verdancy
          </a>
          <p>You grow plants. We grow forests. A calm plant companion that plants real trees.</p>
        </div>
        <div class="footer-cols">
          <div class="footer-col">
            <h4>Product</h4>
            <a href="#tour">Screens</a>
            <a href="#trees">Real trees</a>
            <a href="/trees.html">Tree counter</a>
            <a href={appStoreUrl}>Download</a>
          </div>
          <div class="footer-col">
            <h4>Company</h4>
            <a href="/support.html">Support</a>
            <a href="/privacy.html">Privacy</a>
            <a href="/terms.html">Terms</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 Verdancy · com.verdancy.app</span>
        <span>Trees planted with our partner Tree Nation 🌱</span>
      </div>
    </div>
  </footer>
</Layout>

<script is:inline>
  // Count-up animation for the tree counters, triggered on scroll into view.
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    function animate(el) {
      var target = parseInt(el.getAttribute("data-count-to"), 10) || 0;
      if (reduce) { el.textContent = target.toLocaleString("en-US"); return; }
      var start = null, dur = 1600;
      function step(ts) {
        if (!start) start = ts;
        var p = Math.min((ts - start) / dur, 1);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.floor(eased * target).toLocaleString("en-US");
        if (p < 1) requestAnimationFrame(step);
        else el.textContent = target.toLocaleString("en-US");
      }
      requestAnimationFrame(step);
    }
    var els = document.querySelectorAll("[data-count-to]");
    if (!("IntersectionObserver" in window)) { els.forEach(animate); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { animate(e.target); io.unobserve(e.target); }
      });
    }, { threshold: 0.4 });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>

<style>
  /* ---- gradient text ---- */
  .grad-text {
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* ---- HERO ---- */
  .hero { padding: 64px 0 48px; overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .hero-copy .pill-badge { margin-bottom: 24px; }
  .hero-copy h1 { font-size: clamp(40px, 6vw, 68px); letter-spacing: -0.03em; }
  .lede { margin-top: 22px; font-size: clamp(17px, 2vw, 20px); color: var(--text-secondary); max-width: 540px; }
  .lede strong { color: var(--text); font-weight: 700; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .hero-trust {
    display: flex; align-items: center; gap: 8px; flex-wrap: nowrap;
    margin-top: 26px; font-size: 14px; color: var(--text-secondary);
  }
  .hero-trust svg { width: 20px; height: 20px; color: var(--leaf); flex: none; }
  .hero-trust strong { color: var(--text); }

  /* ---- Phone mock ---- */
  .hero-visual { position: relative; display: flex; justify-content: center; align-items: center; }
  .glow {
    position: absolute; width: 420px; height: 420px; border-radius: 50%;
    background: radial-gradient(circle, var(--leaf-tint-strong), transparent 68%);
    filter: blur(10px); z-index: 0;
  }
  .phone {
    position: relative; z-index: 1;
    width: min(320px, 82vw);
    background: #0d100b;
    border-radius: 42px;
    padding: 12px;
    box-shadow: var(--shadow-float);
    border: 1px solid var(--separator);
  }
  .phone-screen {
    background: var(--surface);
    border-radius: 32px;
    overflow: hidden;
    aspect-ratio: 9 / 18.5;
    display: flex;
    flex-direction: column;
  }
  .scan-photo {
    position: relative; flex: 1.15;
    background: linear-gradient(160deg, #EAF6EC, #cfe9d4);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  :root[data-theme="dark"] .scan-photo { background: linear-gradient(160deg, #1f2a1e, #16201a); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .scan-photo { background: linear-gradient(160deg, #1f2a1e, #16201a); }
  }
  .plant-art { width: 74%; }
  .scan-frame { position: absolute; inset: 18px; }
  .scan-frame span { position: absolute; width: 26px; height: 26px; border: 3px solid rgba(255,255,255,.9); }
  .scan-frame span:nth-child(1){ top:0; left:0; border-right:0; border-bottom:0; border-radius: 8px 0 0 0;}
  .scan-frame span:nth-child(2){ top:0; right:0; border-left:0; border-bottom:0; border-radius: 0 8px 0 0;}
  .scan-frame span:nth-child(3){ bottom:0; left:0; border-right:0; border-top:0; border-radius: 0 0 0 8px;}
  .scan-frame span:nth-child(4){ bottom:0; right:0; border-left:0; border-top:0; border-radius: 0 0 8px 0;}
  .scan-sweep {
    position: absolute; left: 18px; right: 18px; height: 3px;
    background: #6FB477; box-shadow: 0 0 14px 3px rgba(111,180,119,.9);
    animation: sweep 3s ease-in-out infinite;
  }
  @keyframes sweep { 0%,100%{ top: 22px; } 50%{ top: calc(100% - 22px);} }

  .scan-result { background: var(--surface); padding: 16px 16px 20px; }
  .sr-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .sr-name { font-size: 17px; font-weight: 700; letter-spacing: -0.02em; }
  .sr-sub { font-size: 12.5px; color: var(--text-secondary); margin-top: 2px; }
  .sr-match {
    font-size: 13px; font-weight: 700; color: var(--leaf);
    background: var(--leaf-tint); padding: 4px 9px; border-radius: 999px; flex: none;
  }
  .sr-chips { display: flex; gap: 8px; margin-top: 12px; }
  .sr-care { margin-top: 14px; display: flex; flex-direction: column; gap: 10px; }
  .sr-care-item { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--text-secondary); }
  .sr-care-item b { color: var(--text); font-weight: 600; }
  .sr-care-item svg { width: 20px; height: 20px; color: var(--leaf); flex: none; }

  .float-badge {
    position: absolute; z-index: 2;
    display: flex; align-items: center; gap: 10px;
    background: var(--surface); border: 1px solid var(--separator);
    border-radius: 16px; padding: 10px 14px; box-shadow: var(--shadow-float);
  }
  .float-badge b { display: block; font-size: 13px; }
  .float-badge small { display: block; font-size: 11.5px; color: var(--text-secondary); }
  .float-badge .fb-icon { font-size: 20px; }
  .float-buddy { top: 12%; left: -6%; animation: bob 4s ease-in-out infinite; }
  .float-streak { bottom: 14%; right: -6%; animation: bob 4s ease-in-out 1.2s infinite; }
  @keyframes bob { 0%,100%{ transform: translateY(0);} 50%{ transform: translateY(-8px);} }

  @media (max-width: 940px) {
    .hero-grid { grid-template-columns: 1fr; gap: 44px; }
    .hero-visual { order: -1; }
    .float-buddy { left: 2%; }
    .float-streak { right: 2%; }
  }
  @media (max-width: 420px) {
    .hero-trust { align-items: flex-start; }
  }

  /* ---- PILLARS ---- */
  .pillars { background: var(--surface-2); }
  .pillar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .pillar h3 { margin: 18px 0 8px; font-size: 21px; }
  .pillar p { color: var(--text-secondary); font-size: 15.5px; }
  .pillar p strong { color: var(--text); }

  /* ---- APP TOUR / SCREENS ---- */
  .tour { background: var(--surface-2); }
  .tour-grid {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    /* 4 across on large screens -> 8 shots make two clean rows */
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .tour-shot {
    border-radius: 28px;
    overflow: hidden;
    background: #0d100b;
    border: 1px solid var(--separator);
    box-shadow: var(--shadow-float);
    transition: transform 0.25s ease;
  }
  .tour-shot:hover { transform: translateY(-6px); }
  .tour-shot img { display: block; width: 100%; height: auto; }
  @media (max-width: 960px) {
    .tour-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }
  @media (max-width: 520px) {
    .tour-grid { grid-template-columns: 1fr; gap: 18px; max-width: 320px; margin-inline: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tour-shot { transition: none; }
  }

  @media (max-width: 860px) {
    .pillar-grid { grid-template-columns: 1fr; }
  }

  /* ---- TREE COUNTER ---- */
  .trees-panel {
    position: relative; overflow: hidden;
    background: var(--gradient);
    border-radius: 28px;
    padding: 56px;
    color: #fff;
    display: grid; grid-template-columns: 1.3fr 0.7fr; align-items: center; gap: 32px;
    box-shadow: var(--shadow-float);
  }
  .eyebrow.on-grad { color: rgba(255,255,255,.85); }
  .trees-copy h2 { color: #fff; font-size: clamp(30px, 4vw, 44px); }
  .trees-copy p { margin-top: 16px; color: rgba(255,255,255,.9); font-size: 17px; max-width: 560px; }
