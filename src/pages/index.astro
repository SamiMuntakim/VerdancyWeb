<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Verdancy — Scan it. Meet its pixel spirit. Heal the planet.</title>
<meta name="description" content="Verdancy identifies any houseplant from a photo and turns it into a unique pixel companion for your personal dex. Every scan removes 1kg of CO2 — every subscription plants 10 trees.">
<link rel="icon" href="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABYAAAAWCAYAAADEtGw7AAAAaklEQVR4nGNgGAVQwAhjyEmJ/aeGgY+evWJkYGBgYKKGYdgAC7oAr4Esw+cLjxkYGBgYbl7fRLRB6pp+KHz6uRgfMInMxip+ZvlUDLHB4WJsLsMFBoeLR8OYLEBRGOPzAc1cPPRKt1EABwAZShs7j+PHAQAAAABJRU5ErkJggg==">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;600;700&family=Silkscreen:wght@400;700&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;1,600&display=swap" rel="stylesheet">
<style>
  /* ============ TOKENS ============ */
  :root{
    --cream:#F8F2CC;
    --cream-deep:#EFE5AC;
    --paper:#FFFCF1;
    --ink:#221C16;
    --moss-900:#1E3320;
    --moss-700:#2B4A33;
    --moss-500:#3C6347;
    --leaf:#4F8F5B;
    --leaf-light:#8FC79A;
    
    /* Replaced the pink bloom colors with vibrant greens */
    --bloom:#A3E635;
    --bloom-deep:#65A30D;
    
    --soil:#6B4A2E;
    --soil-light:#9C7349;

    --display: 'Pixelify Sans', system-ui, sans-serif;
    --label: 'Nunito', system-ui, monospace;
    --body: 'Nunito', system-ui, sans-serif;

    --max: 1180px;
    --radius: 22px;
    --radius-sm: 12px;
    --step: 4px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:var(--body);
    color:var(--ink);
    background:var(--cream);
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%; display:block;}
  .pixel-img{ image-rendering:pixelated; image-rendering:-moz-crisp-edges; image-rendering:crisp-edges; }
  a{color:inherit; text-decoration:none;}
  button{font-family:inherit; cursor:pointer;}
  h1,h2,h3{font-family:var(--display); margin:0; line-height:1.08; letter-spacing:-0.01em;}
  p{margin:0;}
  .wrap{max-width:var(--max); margin:0 auto; padding:0 24px;}
  .eyebrow{
    font-family:var(--label);
    font-size:12px;
    letter-spacing:0.12em;
    text-transform:uppercase;
    color:var(--leaf);
  }
  .eyebrow.on-dark{ color:var(--leaf-light); }
  .eyebrow.pink{ color:var(--bloom-deep); }

  :focus-visible{ outline:3px solid var(--bloom-deep); outline-offset:3px; border-radius:4px; }

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important;}
  }

  /* ============ PIXEL FRAME (signature border) ============ */
  .pixel-frame{
    position:relative;
    border:3px solid var(--ink);
    border-radius:var(--radius);
    clip-path: polygon(
      var(--step) 0%, calc(100% - var(--step)) 0%, 100% var(--step), 100% calc(100% - var(--step)),
      calc(100% - var(--step)) 100%, var(--step) 100%, 0% calc(100% - var(--step)), 0% var(--step)
    );
  }
  .pixel-btn{
    display:inline-flex; align-items:center; gap:8px; justify-content:center;
    font-family:var(--display); font-weight:600; font-size:16px;
    padding:15px 28px;
    border:3px solid var(--ink);
    background:var(--leaf-light);
    color:var(--ink);
    box-shadow:4px 4px 0 var(--ink);
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .pixel-btn:hover{ transform:translate(-2px,-2px); box-shadow:6px 6px 0 var(--ink); }
  .pixel-btn:active{ transform:translate(1px,1px); box-shadow:2px 2px 0 var(--ink); }
  .pixel-btn.primary{ background:var(--bloom); }
  .pixel-btn.dark{ background:var(--moss-700); color:var(--cream); border-color:var(--ink); }
  .pixel-btn.ghost{ background:transparent; box-shadow:none; }
  .pixel-btn.ghost:hover{ box-shadow:none; transform:none; background:rgba(0,0,0,0.05); }
  .pixel-btn.small{ padding:10px 18px; font-size:13px; box-shadow:3px 3px 0 var(--ink);}

  /* ============ HEADER ============ */
  header{
    position:sticky; top:0; z-index:50;
    background:rgba(248,242,204,0.88);
    backdrop-filter:blur(10px);
    border-bottom:3px solid var(--ink);
  }
  .nav{ display:flex; align-items:center; justify-content:space-between; padding:14px 24px; max-width:var(--max); margin:0 auto;}
  .brand{ display:flex; align-items:center; gap:10px; font-family:var(--display); font-weight:700; font-size:21px;}
  .brand .dot{ width:14px;height:14px;background:var(--bloom); border:2px solid var(--ink); display:inline-block;}
  .nav-links{ display:flex; align-items:center; gap:30px; font-family:var(--label); font-size:13px; letter-spacing:0.03em;}
  .nav-links a{ position:relative; padding-bottom:4px; }
  .nav-links a:hover{ color:var(--bloom-deep); }
  .nav-cta{ display:flex; align-items:center; gap:14px;}
  .menu-btn{ display:none; background:none; border:none; padding:6px;}
  .mobile-menu{ display:none; }
  .menu-btn span, .menu-btn span::before, .menu-btn span::after{
    display:block; width:24px; height:3px; background:var(--ink); position:relative; transition:.2s;
  }
  .menu-btn span::before, .menu-btn span::after{ content:''; position:absolute; left:0; }
  .menu-btn span::before{ top:-8px; } .menu-btn span::after{ top:8px; }

  @media (max-width: 860px){
    .nav-links, .nav-cta .pixel-btn.ghost{ display:none; }
    .menu-btn{ display:block; }
    .mobile-menu{
      display:none; flex-direction:column; gap:18px; padding:22px 24px 28px;
      border-top:3px solid var(--ink); background:var(--cream); font-family:var(--label); font-size:14px;
    }
    .mobile-menu.open{ display:flex; }
  }

  /* ============ HERO ============ */
  .hero{ padding:64px 0 40px; }
  .hero-grid{ display:grid; grid-template-columns:1.05fr 0.95fr; gap:48px; align-items:center; }
  @media (max-width:980px){ .hero-grid{ grid-template-columns:1fr; gap:40px; } }

  .hero-pill{
    display:inline-flex; align-items:center; gap:10px;
    border:2px solid var(--ink); border-radius:999px; padding:7px 16px 7px 8px;
    font-family:var(--label); font-size:11px; letter-spacing:.04em; background:var(--paper);
    margin-bottom:22px;
  }
  .hero-pill .swatch{ width:24px;height:24px;border-radius:999px; border:2px solid var(--ink); background:var(--leaf-light); display:flex;align-items:center;justify-content:center; font-size:13px;}

  .hero h1{ font-size:clamp(34px, 5vw, 56px); }
  .hero h1 .accent{ color:var(--leaf); }
  .hero h1 .accent2{ color:var(--bloom-deep); }
  .hero p.lede{ font-size:18px; line-height:1.6; color:var(--moss-700); max-width:520px; margin-top:18px; font-weight:600;}
  .hero-actions{ display:flex; gap:16px; flex-wrap:wrap; margin-top:30px; }
  .hero-meta{ display:flex; gap:26px; margin-top:34px; flex-wrap:wrap;}
  .hero-meta div{ font-family:var(--label); font-size:11px; color:var(--moss-700);}
  .hero-meta strong{ display:block; font-family:var(--display); font-size:22px; color:var(--ink); }

  /* phone / scan mock */
  .phone-wrap{ position:relative; display:flex; justify-content:center; }
  .phone{
    width:min(310px, 86vw); background:var(--ink); border-radius:34px; padding:14px;
    box-shadow:10px 14px 0 rgba(43,74,51,0.25);
  }
  .phone-screen{
    background:var(--paper); border-radius:22px; overflow:hidden; position:relative;
    aspect-ratio: 9/16.2; display:flex; flex-direction:column;
  }
  .scan-stage{
    flex:1; position:relative; display:flex; align-items:center; justify-content:center;
    background:linear-gradient(180deg, var(--cream), var(--paper));
    overflow:hidden;
  }
  .scan-stage img{ width:72%; }
  .scanline{
    position:absolute; left:0; right:0; height:3px; background:var(--bloom-deep);
    box-shadow:0 0 16px 3px var(--bloom-deep);
    animation: sweep 2.6s ease-in-out infinite;
  }
  @keyframes sweep{ 0%{ top:6%; opacity:1;} 48%{ top:92%; opacity:1;} 50%{opacity:0;} 52%{ top:6%; opacity:0;} 54%{opacity:1;} 100%{ top:92%; } }
  .scan-corner{ position:absolute; width:22px; height:22px; border:3px solid var(--moss-700); opacity:.8;}
  .scan-corner.tl{ top:10px; left:10px; border-right:none; border-bottom:none;}
  .scan-corner.tr{ top:10px; right:10px; border-left:none; border-bottom:none;}
  .scan-corner.bl{ bottom:10px; left:10px; border-right:none; border-top:none;}
  .scan-corner.br{ bottom:10px; right:10px; border-left:none; border-top:none;}
  .scan-console{
    background:var(--moss-900); color:var(--leaf-light); padding:14px 16px 16px;
    font-family:var(--label); font-size:11px; letter-spacing:.03em; min-height:74px;
  }
  .scan-console .line{ opacity:0; animation: fadeIn .4s forwards; white-space:nowrap; overflow:hidden;}
  .scan-console .l1{ animation-delay:.2s; }
  .scan-console .l2{ animation-delay:1.6s; color:var(--bloom); }
  .scan-console .l3{ animation-delay:2.4s; color:#fff; font-family:var(--display); font-size:13px; margin-top:6px; display:block;}
  .scan-console .l4{ animation-delay:3s; }
  @keyframes fadeIn{ to{opacity:1;} }
  .impact-pop{
    position:absolute; bottom:18%; right:-14px; background:var(--bloom); border:3px solid var(--ink);
    border-radius:14px; padding:6px 10px; font-family:var(--display); font-size:12px;
    box-shadow:3px 3px 0 var(--ink);
    animation: pop 2.6s ease-in-out infinite;
  }
  @keyframes pop{ 0%,55%{ transform:scale(0); opacity:0;} 65%,90%{ transform:scale(1); opacity:1;} 100%{ transform:scale(1); opacity:1;} }

  /* ============ SECTION GENERIC ============ */
  section{ padding:88px 0; }
  .section-head{ max-width:640px; margin:0 auto 56px; text-align:center; }
  .section-head h2{ font-size:clamp(28px,3.6vw,42px); margin-top:10px; }
  .section-head p{ margin-top:14px; font-size:16px; color:var(--moss-700); font-weight:600; line-height:1.6;}

  /* ============ HOW IT WORKS ============ */
  .steps{ display:grid; grid-template-columns:repeat(3,1fr); gap:26px; }
  @media (max-width:860px){ .steps{ grid-template-columns:1fr; } }
  .step-card{ background:var(--paper); padding:30px 26px; position:relative;}
  .step-num{ font-family:var(--display); font-size:46px; color:var(--leaf-light); -webkit-text-stroke:2px var(--ink); margin-bottom:14px; }
  .step-card h3{ font-size:19px; margin-bottom:10px;}
  .step-card p{ font-size:14.5px; color:var(--moss-700); line-height:1.6; font-weight:600;}

  /* ============ FEATURES ============ */
  .features{ display:grid; grid-template-columns:repeat(4,1fr); gap:22px; }
  @media (max-width:980px){ .features{ grid-template-columns:repeat(2,1fr); } }
  @media (max-width:560px){ .features{ grid-template-columns:1fr; } }
  .feature-card{
    background:var(--paper); padding:26px 22px; display:flex; flex-direction:column; gap:14px;
    transition: transform .15s ease;
  }
  .feature-card:hover{ transform:translateY(-4px); }
  .feature-icon{ width:52px;height:52px; background:var(--cream-deep); border:2px solid var(--ink); display:flex; align-items:center; justify-content:center; border-radius:10px;}
  .feature-icon img{ width:30px; height:30px;}
  .feature-card h3{ font-size:16.5px; }
  .feature-card p{ font-size:14px; color:var(--moss-700); line-height:1.55; font-weight:600;}

  /* ============ IMPACT BAND ============ */
  .impact{ background:var(--moss-900); color:var(--cream); position:relative; overflow:hidden;}
  .impact::before{
    content:''; position:absolute; inset:0; opacity:.5;
    background-image: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1.5px);
    background-size:16px 16px;
  }
  .impact-inner{ position:relative; z-index:1; }
  .impact .section-head p{ color:var(--leaf-light); }
  .impact .section-head h2{ color:#fff; }
  .impact-grid{ display:grid; grid-template-columns:1fr 1fr; gap:24px; max-width:880px; margin:0 auto;}
  @media (max-width:760px){ .impact-grid{ grid-template-columns:1fr; } }
  .impact-card{
    background:var(--moss-700); border:3px solid var(--cream); border-radius:18px; padding:30px 26px;
    display:flex; align-items:center; gap:18px;
  }
  .impact-card .ic{ width:54px;height:54px; flex:none; background:var(--moss-900); border:2px solid var(--leaf-light); border-radius:10px; display:flex; align-items:center; justify-content:center;}
  .impact-card .ic img{ width:32px; height:32px;}
  .impact-card .num{ font-family:var(--display); font-size:30px; color:var(--bloom); display:block;}
  .impact-card .lbl{ font-family:var(--body); font-weight:700; font-size:14.5px; line-height:1.4; color:var(--cream);}
  .impact-counter{
    margin-top:44px; text-align:center; border-top:1px dashed rgba(255,255,255,0.25); padding-top:36px;
  }
  .impact-counter .big{ font-family:var(--display); font-size:clamp(34px,6vw,58px); color:var(--leaf-light); }
  .impact-counter .cap{ font-family:var(--label); font-size:11px; letter-spacing:.06em; color:var(--cream); opacity:.7; margin-top:6px; display:block;}

  /* ============ DEX GALLERY ============ */
  .dex-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
  @media (max-width:980px){ .dex-grid{ grid-template-columns:repeat(2,1fr); } }
  @media (max-width:520px){ .dex-grid{ grid-template-columns:1fr 1fr; } }
  .dex-card{
    background:var(--paper); padding:16px; text-align:center; position:relative;
  }
  .dex-card .tag{ position:absolute; top:10px; left:10px; background:var(--bloom); border:2px solid var(--ink); font-family:var(--label); font-size:9px; padding:3px 6px; border-radius:6px;}
.dex-card.featured img{ 
    width:78%; 
    aspect-ratio: 1 / 1; /* Forces every image into a perfect square */
    object-fit: cover; /* Fills the square without squishing the pixel art */
    margin:6px auto 8px; 
  }  .dex-card h4{ font-family:var(--display); font-size:14px; margin-top:6px;}
  .dex-card .sp{ font-family:var(--body); font-style:italic; font-size:11.5px; color:var(--moss-700); margin-top:2px; font-weight:700;}
  .dex-card .stat{ margin-top:10px; display:inline-flex; gap:6px; font-family:var(--label); font-size:10px; background:var(--cream-deep); border:2px solid var(--ink); border-radius:8px; padding:4px 8px;}

  .dex-card.locked{ display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; min-height:220px; background:repeating-linear-gradient(135deg, var(--cream-deep) 0 10px, var(--paper) 10px 20px);}
  .dex-locked-blob{ width:64px; height:64px; border-radius:50% 50% 46% 46%; background:var(--moss-500); border:3px solid var(--ink); display:flex; align-items:center; justify-content:center; font-family:var(--display); color:var(--cream); font-size:26px;}
  .dex-card.locked p{ font-family:var(--label); font-size:11px; color:var(--moss-700); }

  /* ============ TESTIMONIALS ============ */
  .testimonials{ background:var(--soil); color:var(--cream); }
  .testimonials .section-head h2{ color:#fff; }
  .testimonials .section-head p{ color:var(--cream-deep); }
  .t-grid{ display:flex; flex-wrap:wrap; gap:22px; justify-content:center; }
  .t-card{
    width:300px; background:rgba(255,255,255,0.06); border:2px solid rgba(255,255,255,0.25); border-radius:16px;
    padding:24px; display:flex; flex-direction:column; gap:14px; transition:transform .15s ease, background .15s ease;
  }
  .t-card:hover{ transform:translateY(-4px); background:rgba(255,255,255,0.1); }
  .t-card .quote-mark{ font-family:var(--display); font-size:34px; color:var(--bloom); line-height:1;}
  .t-card p.quote{ font-size:14.5px; line-height:1.6; font-weight:600;}
  .t-who{ display:flex; align-items:center; gap:10px; margin-top:auto;}
  .t-avatar{ width:36px;height:36px; border-radius:50%; background:var(--leaf-light); border:2px solid var(--cream); display:flex; align-items:center; justify-content:center; font-family:var(--display); font-size:13px; color:var(--ink);}
  .t-who .name{ font-family:var(--label); font-size:12px; }

  /* ============ FINAL CTA ============ */
  .final-cta{ text-align:center; }
  .final-cta h2{ font-size:clamp(28px,4.4vw,46px); }
  .final-cta p{ margin-top:14px; font-size:16px; color:var(--moss-700); font-weight:700;}
  .final-cta .hero-actions{ justify-content:center; margin-top:28px;}
  .final-cta small{ display:block; margin-top:16px; font-family:var(--label); font-size:11px; color:var(--moss-700); opacity:.8;}

  /* ============ FOOTER ============ */
  footer{ background:var(--ink); color:var(--cream-deep); padding:60px 0 26px;}
  .foot-grid{ display:grid; grid-template-columns:1.4fr 1fr 1fr; gap:34px; }
  @media (max-width:760px){ .foot-grid{ grid-template-columns:1fr; gap:30px;} }
  .foot-brand{ font-family:var(--display); font-size:20px; color:#fff; display:flex; align-items:center; gap:8px;}
  footer p.tag{ margin-top:10px; font-size:13.5px; max-width:280px; line-height:1.6; font-weight:600; opacity:.85;}
  footer h5{ font-family:var(--label); font-size:12px; color:var(--leaf-light); letter-spacing:.06em; margin:0 0 14px;}
  footer ul{ list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:10px; font-size:13.5px;}
  footer a:hover{ color:#fff; }
  .foot-bottom{ margin-top:46px; padding-top:22px; border-top:1px solid rgba(255,255,255,0.12); display:flex; justify-content:space-between; flex-wrap:wrap; gap:14px; font-size:12.5px; opacity:.7;}
  .foot-bottom .socials{ display:flex; gap:18px; font-family:var(--label); font-size:11px;}

  .note{ font-size:11px; opacity:.55; font-family:var(--label); }
</style>
</head>
<body>

<header>
  <div class="nav">
    <a href="#top" class="brand"><span class="dot"></span>Verdancy</a>
    <nav class="nav-links">
      <a href="#how">How it works</a>
      <a href="#impact">Impact</a>
      <a href="#dex">The Dex</a>
      <a href="#stories">Stories</a>
    </nav>
    <div class="nav-cta">
      <a href="#how" class="pixel-btn ghost small">Login</a>
      <a href="#get" class="pixel-btn small">Get Verdancy</a>
      <button class="menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false"><span></span></button>
    </div>
  </div>
  <div class="mobile-menu" id="mobileMenu">
    <a href="#how">How it works</a>
    <a href="#impact">Impact</a>
    <a href="#dex">The Dex</a>
    <a href="#stories">Stories</a>
    <a href="#get" class="pixel-btn small" style="width:fit-content;">Get Verdancy</a>
  </div>
</header>

<main id="top">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="hero-pill"><span class="swatch">🌿</span> Carbon-negative, one scan at a time</div>
        <h1>Snap a plant.<br>Meet its <span class="accent">pixel spirit</span>.<br>Help it <span class="accent2">heal the planet</span>.</h1>
        <p class="lede">Verdancy identifies any houseplant from a single photo, then renders it as a one-of-a-kind pixel companion for your personal dex. Every scan removes real carbon — every subscription plants real trees.</p>
        <div class="hero-actions">
          <a href="#get" class="pixel-btn primary">Start Scanning — It's Free</a>
          <a href="#how" class="pixel-btn ghost">See how it works ↓</a>
        </div>
        <div class="hero-meta">
          <div><strong>30,000+</strong>species recognized</div>
          <div><strong>1 kg</strong>CO₂ removed / scan</div>
          <div><strong>10 trees</strong>planted / subscription</div>
        </div>
      </div>

      <div class="phone-wrap">
        <div class="phone">
          <div class="phone-screen">
            <div class="scan-stage">
              <img src="data:image/png;base64," class="pixel-img" alt="Pixel art companion of a golden barrel cactus, generated by Verdancy">
              <div class="scanline"></div>
              <div class="scan-corner tl"></div><div class="scan-corner tr"></div>
              <div class="scan-corner bl"></div><div class="scan-corner br"></div>
              <div class="impact-pop">+1kg CO₂ ✓</div>
            </div>
            <div class="scan-console">
              <span class="line l1">&gt; analyzing leaf pattern...</span><br>
              <span class="line l2">&gt; match found: 98.2% confidence</span>
              <span class="line l3">Golden Barrel Cactus 🌵</span>
              <span class="line l4">added to your Dex · #0042</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">The loop</span>
        <h2>Three steps. One greener dex.</h2>
        <p>No setup, no plant ID degree required — just your camera and a bit of curiosity.</p>
      </div>
      <div class="steps">
        <div class="step-card pixel-frame">
          <span class="step-num">01</span>
          <h3>Snap a photo</h3>
          <p>Point your camera at any leaf, stem, or flower — indoors, outdoors, half-dead, doesn't matter.</p>
        </div>
        <div class="step-card pixel-frame">
